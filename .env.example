# Template — copy to .env.local and fill in real values: cp .env.example .env.local

DATABASE_URL="postgresql://<user>:<password>@localhost:5432/<database>?schema=public"
REDIS_URL="redis://localhost:6379"
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<at-least-32-char-random-string>

NEXT_PUBLIC_APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=

GATEWAY_PORT=4001
GATEWAY_WS_URL=ws://localhost:4001

RUNTIME_ENABLE_GPU=0
VIDEO_ENCODER=libx264

POSTGRES_USER=infinity
POSTGRES_PASSWORD=infinity
POSTGRES_DB=infinity
