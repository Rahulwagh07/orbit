# WebRTC runtime agent — VS Code edition
# Base: chromium runtime image (Xvfb, fluxbox, ffmpeg, xdotool, node 18)
# Build from repo root: docker build -f runtime/agent/Dockerfile.vscode -t orbit-vscode .
FROM orbit-chromium

USER root
WORKDIR /home/orbit

# Install VS Code desktop
RUN apt-get update \
  && apt-get install -y --no-install-recommends curl gpg ca-certificates \
  && curl -fsSL https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor -o /usr/share/keyrings/microsoft.gpg \
  && echo "deb [arch=amd64 signed-by=/usr/share/keyrings/microsoft.gpg] https://packages.microsoft.com/repos/code stable main" > /etc/apt/sources.list.d/vscode.list \
  && apt-get update \
  && apt-get install -y --no-install-recommends code \
  && rm -rf /var/lib/apt/lists/*

RUN rm -rf node_modules
RUN apt-get update \
  && apt-get install -y --no-install-recommends pulseaudio pulseaudio-utils \
  && rm -rf /var/lib/apt/lists/*

COPY runtime/agent/package.json runtime/agent/tsconfig.json ./
COPY runtime/agent/src ./src
COPY packages/typescript-config ./packages/typescript-config

RUN sed -i 's|"extends": "../../packages/typescript-config/base.json"|"extends": "./packages/typescript-config/base.json"|' tsconfig.json
RUN npm install --no-audit --no-fund
RUN npm run build
RUN rm -rf src packages && chown -R orbit:orbit /home/orbit

USER orbit

ENV APP_COMMAND=code
ENV APP_EXECUTABLE=/usr/share/code/code
ENV APP_WINDOW_CLASS=Code

EXPOSE 8080

CMD ["node", "dist/index.js"]
