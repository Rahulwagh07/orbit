# WebRTC runtime agent — Terminal edition

# Base: chromium runtime image (Xvfb, fluxbox, ffmpeg, xdotool, node 18)
# Build from repo root: docker build -f runtime/agent/Dockerfile.terminal -t orbit-terminal .

FROM orbit-chromium

USER root

WORKDIR /home/orbit

# Install xfce4-terminal — full desktop terminal emulator (tabs, truecolor,
# themes). No downgraded substitutes (e.g. bare xterm).
RUN apt-get update \
  && apt-get install -y --no-install-recommends xfce4-terminal dbus-x11 \
  && rm -rf /var/lib/apt/lists/*

RUN rm -rf node_modules

RUN apt-get update \
  && apt-get install -y --no-install-recommends pulseaudio pulseaudio-utils \
  && rm -rf /var/lib/apt/lists/*

COPY runtime/agent/package.json runtime/agent/tsconfig.json ./

COPY runtime/agent/src ./src
COPY packages/typescript-config ./packages/typescript-config

RUN sed -i 's|"extends": "../../packages/typescript-config/base.json"|"extends": "./packages/typescript-config/base.json"|' tsconfig.json

RUN npm install --no-audit --no-fund

RUN npm run build

RUN rm -rf src packages && chown -R orbit:orbit /home/orbit

USER orbit

ENV APP_COMMAND=xfce4-terminal

ENV APP_EXECUTABLE=/usr/bin/xfce4-terminal

ENV APP_WINDOW_CLASS=Xfce4-terminal

# --disable-server: run standalone instead of DBus single-instance mode,
# which is unavailable inside the container
ENV APP_EXTRA_ARGS=--disable-server

EXPOSE 8080

CMD ["node", "dist/index.js"]
